<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose (start and while the first frame draws); Compose draws everything else. -->
    <style name="Theme.StarkLLM" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- one deadline in the home-screen widget -->
    <style name="WidgetRow">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#FFE7E5F0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>

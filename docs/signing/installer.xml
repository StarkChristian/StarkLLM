<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": signs the NSIS installer StarkLLM-v<version>-Setup.exe
     (uploaded as a single file, not zipped). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <pe-file path="StarkLLM-v${version}-Setup.exe" product-name="StarkLLM" product-version="${version}">
    <authenticode-sign />
  </pe-file>
</artifact-configuration>

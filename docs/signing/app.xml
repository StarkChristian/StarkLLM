<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": signs StarkLLM.exe inside the zipped app folder (win-unpacked).
     All other files (Electron and Chromium libraries, resources) are files of other projects or data and stay as they are.
     electron-builder writes the product version of StarkLLM.exe with four parts (2.0.15.0) and the file version with three. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="StarkLLM.exe" product-name="StarkLLM" product-version="${version}.0" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
